{
  "name": "landmark-claim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n srv,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "funfacts": "tsx server/funfacts.ts",
    "snapshot": "tsx server/snapshot.ts",
    "specimen": "SEEN_SPECIMEN=1 SEEN_DATA_DIR=data-specimen PORT=8788 tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^5.0.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
