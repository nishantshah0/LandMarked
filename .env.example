# Copy to .env and fill in. Nothing here is required — the game is fully
# playable with an empty .env; each key only switches on an extra layer.

# ── Vision + questions (either provider) ──────────────────────────────────
# Both server/vision.ts and server/funfacts.ts run on OpenAI or Anthropic.
# OPENAI_API_KEY wins when both are set. With neither, claims still pass on the
# deterministic GPS + perceptual-hash checks and are logged as unverified, and
# no questions are generated.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_FUNFACT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5
FUNFACT_MODEL=claude-opus-5

# ── Admin ─────────────────────────────────────────────────────────────────
# Required to register a finished 3D model over HTTP (from your phone, during
# the event). Any long random string. If unset, that endpoint is disabled and
# you register models with `npm run splat` on the machine instead.
ADMIN_TOKEN=

# ── 3D model generation (optional) ────────────────────────────────────────
# NOTE: Luma's Capture API — the one the plan named — was discontinued and its
# client was archived in Sept 2024, so there is no drop-in Luma key to paste.
# These vars point at ANY service that turns a zip of photos into a splat file.
# Leave blank and use the manual path instead:
#   1. GET /api/landmark/<id>/photos.zip   (button in the app)
#   2. run that zip through Luma's web app / Polycam / Postshot
#   3. npm run splat <id> ./model.ply
#
# Contract the generic provider expects, if you do have a service:
#   POST $SPLAT_API_URL          multipart form, field "file" = the zip
#                                -> 200 {"id": "..."} or {"url": "..."}
#   GET  $SPLAT_STATUS_URL/<id>  -> {"status":"pending|ready|failed","url":"..."}
SPLAT_API_URL=
SPLAT_STATUS_URL=
SPLAT_API_KEY=
