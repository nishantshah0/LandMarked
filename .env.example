# Copy to .env and fill in. Nothing here is required — the game is fully
# playable with an empty .env; each key only switches on an extra layer.

# ── Vision + questions ────────────────────────────────────────────────────
# Claude first, then Gemini, then OpenAI (see server/llm.ts). Each link is only
# tried if the ones before it are missing or fail, so setting one key is enough.
# With neither key, claims still pass on the deterministic GPS + perceptual-hash
# checks and are logged as unverified, and no questions are generated.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model overrides — only set these if you want something other than the default.
# Both default to Haiku 4.5, the cheapest Claude ($1/$5 per 1M vs Opus's $5/$25).
# claude-sonnet-5 is the next step up if generated questions read thin.
VISION_MODEL=claude-haiku-4-5
FUNFACT_MODEL=claude-haiku-4-5
# Set these to a model your Gemini key actually has access to; the default is a
# reasonable guess, not a guarantee.
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_FUNFACT_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_FUNFACT_MODEL=gpt-4o-mini

# ── Admin ─────────────────────────────────────────────────────────────────
# Only needed to attach a 3D model over HTTP (from your phone, mid-event) via
# POST /api/landmark/:id/splat. Invent any long random string. Leave blank and
# that endpoint stays off — use `npm run splat` on the machine instead.
ADMIN_TOKEN=

# ── 3D model generation ───────────────────────────────────────────────────
# LEAVE THESE BLANK. There is no key to obtain — Luma's Capture API, the
# service this was written for, was discontinued and its client archived in
# Sept 2024. They exist only so that any future zip-of-photos -> splat-file
# service can be dropped in without a code change.
#
# The two paths that actually work need none of this:
#   npx tsx server/set-splat.ts <id> "https://lumalabs.ai/embed/..."   (phone capture)
#   npm run splat -- <id> ./model.ply                                  (from the archive)
SPLAT_API_URL=
SPLAT_STATUS_URL=
SPLAT_API_KEY=
